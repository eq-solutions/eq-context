#!/usr/bin/env bash
#
# eq-context pre-commit hook
# Enforces system/md-style.md anti-patterns locally before any commit.
#
# Activated by: git config core.hooksPath .githooks
# (run scripts/install-hooks.ps1 once after cloning to enable).
#
# Bypass (only when truly needed): git commit --no-verify

set -e

RED=$'\033[0;31m'
YELLOW=$'\033[0;33m'
GREEN=$'\033[0;32m'
NC=$'\033[0m'

violations=0
warnings=0

# ----------------------------------------------------------------------
# Secret-pattern guard — runs FIRST, before any style check.
#
# Until 2026-08-04 this repo had TWO pre-commit hooks and could only ever
# run one: core.hooksPath pointed at .git/hooks (holding an untracked copy
# of scripts/pre-commit-secrets.sh), so THIS governed hook never ran at
# all. Pointing core.hooksPath here without this block would have silently
# traded a credential-leak guard for a style guard — a strict downgrade.
# Delegating keeps both, with one governed, version-controlled entry point.
#
# Fail-closed: a missing guard script blocks the commit rather than
# quietly skipping. See system/lessons.md, "The First Guard I Wrote Failed
# Open, Silently".
# ----------------------------------------------------------------------
secret_guard="$(git rev-parse --show-toplevel)/scripts/pre-commit-secrets.sh"
if [ -f "$secret_guard" ]; then
    if ! bash "$secret_guard"; then
        echo "${RED}Pre-commit blocked by the secret guard (detail above).${NC}"
        exit 1
    fi
else
    echo "${RED}BLOCK: scripts/pre-commit-secrets.sh not found — refusing to commit.${NC}"
    echo "  The secret guard must never be skipped silently. Restore the script,"
    echo "  or bypass deliberately with: git commit --no-verify"
    exit 1
fi

# Get the list of files staged for commit (Added, Copied, Modified, Renamed)
staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$staged_files" ]; then
    exit 0
fi

# ----------------------------------------------------------------------
# 17.1 — Per-version changelog files (CHANGELOG-vX.Y.Z.md) — BLOCK
# ----------------------------------------------------------------------
echo "$staged_files" | grep -iE '(^|/)CHANGELOG-v[0-9]+\.[0-9]+(\.[0-9]+)?\.md$' > /tmp/_pre_v_chk_$$ || true
if [ -s /tmp/_pre_v_chk_$$ ]; then
    echo "${RED}BLOCK: per-version changelog files (use rolling CHANGELOG.md):${NC}"
    sed 's/^/  - /' /tmp/_pre_v_chk_$$
    echo "  Fix: append the version section into CHANGELOG.md and unstage the per-version file."
    violations=$((violations+1))
fi
rm -f /tmp/_pre_v_chk_$$

# ----------------------------------------------------------------------
# 17.2 — Binary files in eq-context — BLOCK
# ----------------------------------------------------------------------
echo "$staged_files" | grep -iE '\.(zip|tar|gz|7z|docx|doc|xlsx|xls|pptx|ppt|pdf|png|jpg|jpeg|gif|bmp|webp|mov|mp4|mp3|wav)$' > /tmp/_pre_bin_$$ || true
if [ -s /tmp/_pre_bin_$$ ]; then
    echo "${RED}BLOCK: binary files do not belong in eq-context:${NC}"
    sed 's/^/  - /' /tmp/_pre_bin_$$
    echo "  Fix: move artefacts to a project folder or S3/R2; unstage with 'git reset HEAD <file>'."
    violations=$((violations+1))
fi
rm -f /tmp/_pre_bin_$$

# ----------------------------------------------------------------------
# 17.3 — _cleanup-patch-* folders — BLOCK
# ----------------------------------------------------------------------
echo "$staged_files" | grep -E '(^|/)_cleanup-patch-[^/]+/' > /tmp/_pre_cp_$$ || true
if [ -s /tmp/_pre_cp_$$ ]; then
    echo "${RED}BLOCK: half-applied cleanup-patch folders should not be committed:${NC}"
    sed 's/^/  - /' /tmp/_pre_cp_$$
    echo "  Fix: apply the cleanup now or move it to a feature branch. See system/md-style.md."
    violations=$((violations+1))
fi
rm -f /tmp/_pre_cp_$$

# ----------------------------------------------------------------------
# 17.4 — Non-canonical session filenames — BLOCK
# ----------------------------------------------------------------------
echo "$staged_files" | grep -E '^sessions/' | grep -vE '^sessions/[0-9]{4}-[0-9]{2}-[0-9]{2}(-[a-z0-9-]+)?\.md$' > /tmp/_pre_sess_$$ || true
if [ -s /tmp/_pre_sess_$$ ]; then
    echo "${RED}BLOCK: non-canonical filenames in sessions/ (must match YYYY-MM-DD.md or YYYY-MM-DD-<part>.md):${NC}"
    sed 's/^/  - /' /tmp/_pre_sess_$$
    echo "  Fix: rename to sessions/YYYY-MM-DD.md (or a -<part> suffix), or append to the existing dated file."
    violations=$((violations+1))
fi
rm -f /tmp/_pre_sess_$$

# ----------------------------------------------------------------------
# 17.5 — Frontmatter `status:` must be a valid enum value — BLOCK
#
# Promoted to rung 4 on 2026-08-04 after the same defect landed on main
# twice in four days (2026-08-03 and 2026-08-04): prose written into the
# `status:` field, e.g. `status: live, plus a signature-pad upgrade`.
# Both times CI caught it (rung 3) only AFTER the push, leaving
# Frontmatter validation red on main and on every branch cut from it.
#
# The exemption list below MUST stay identical to the one in
# .github/workflows/frontmatter-check.yml. If they drift, this hook
# either blocks what CI allows or waves through what CI rejects — both
# worse than no hook, because both teach you to distrust it.
# ----------------------------------------------------------------------
echo "$staged_files" | grep -iE '\.md$' > /tmp/_pre_status_$$ || true
if [ -s /tmp/_pre_status_$$ ]; then
    status_bad=0
    while read -r mdfile; do
        [ -f "$mdfile" ] || continue
        # Exemptions — keep in lockstep with frontmatter-check.yml.
        case "$mdfile" in
            README.md|*/README.md|COWORK-PROMPT.md|CHAT-PROMPT.md|AGENTS.md|archive/*|drafts/*|sessions/*|*/changelog/*|.github/*|.githooks/*|md-health-reports/*)
                continue ;;
        esac
        first=$(head -1 "$mdfile" | tr -d '\r' | sed $'s/^\xef\xbb\xbf//')
        # No frontmatter at all is a separate check's business, not this one.
        [ "$first" = "---" ] || continue
        fm=$(awk 'NR==1{next} /^---[[:space:]]*$/{exit} {print}' "$mdfile" | tr -d '\r')
        st=$(echo "$fm" | grep -E '^status:' | head -1 | sed -E 's/^status:[[:space:]]*//' | tr -d '"' | tr -d "'")
        if ! echo "$fm" | grep -qE '^status:'; then
            if [ "$status_bad" = "0" ]; then
                echo "${RED}BLOCK: invalid frontmatter 'status:' (must be live|draft|archived|deprecated):${NC}"
            fi
            echo "  - $mdfile — no 'status:' key (required by system/md-style.md)"
            status_bad=$((status_bad+1))
            continue
        fi
        case "$st" in
            live|draft|archived|deprecated) ;;
            *)
                if [ "$status_bad" = "0" ]; then
                    echo "${RED}BLOCK: invalid frontmatter 'status:' (must be live|draft|archived|deprecated):${NC}"
                fi
                echo "  - $mdfile — got: '$st'"
                status_bad=$((status_bad+1)) ;;
        esac
    done < /tmp/_pre_status_$$
    if [ "$status_bad" -gt 0 ]; then
        echo "  Fix: set status: to one of the four values. Detail and caveats belong"
        echo "       in a body '**Status:**' line, not in the frontmatter field."
        violations=$((violations+1))
    fi
fi
rm -f /tmp/_pre_status_$$

# ----------------------------------------------------------------------
# Duplicate-content check across staged + tracked sessions
# Compares sha1 of session files; flags any duplicates.
# ----------------------------------------------------------------------
if echo "$staged_files" | grep -q '^sessions/'; then
    # Build a temp file of "sha1  path" for every sessions/*.md in the working tree
    : > /tmp/_pre_sha_$$
    for f in sessions/*.md; do
        if [ -f "$f" ]; then
            sha=$(git hash-object "$f")
            echo "$sha $f" >> /tmp/_pre_sha_$$
        fi
    done
    # Find duplicate hashes
    sort /tmp/_pre_sha_$$ | awk '{print $1}' | uniq -d > /tmp/_pre_sha_dup_$$
    if [ -s /tmp/_pre_sha_dup_$$ ]; then
        echo "${RED}BLOCK: duplicate session content detected (same SHA, different paths):${NC}"
        while read -r dup_sha; do
            grep "^$dup_sha " /tmp/_pre_sha_$$ | sed 's/^/  /'
        done < /tmp/_pre_sha_dup_$$
        echo "  Fix: delete one of each pair before committing."
        violations=$((violations+1))
    fi
    rm -f /tmp/_pre_sha_$$ /tmp/_pre_sha_dup_$$
fi

# ----------------------------------------------------------------------
# Tool-attribution drift in substrate prose — WARN (not block)
# (See system/md-style.md "Tool-neutral writing")
# Flags newly-added MD content that uses tool brand names instead of
# the tool-neutral `assistant` convention. Only checks staged additions
# (lines starting with `+`), so existing prose isn't re-warned forever.
# ----------------------------------------------------------------------
attr_warnings=0
echo "$staged_files" | grep -iE '\.md$' > /tmp/_pre_attr_$$ || true
if [ -s /tmp/_pre_attr_$$ ]; then
    while read -r mdfile; do
        [ -f "$mdfile" ] || continue
        # Files where tool-name examples are intentional or out-of-scope.
        case "$mdfile" in
            README.md|COWORK-PROMPT.md|system/md-style.md|system/onboarding.md|archive/*|.github/*|.githooks/*) continue ;;
        esac
        matches=$(git diff --cached "$mdfile" | grep -E '^\+[^+]' | grep -iE '(Claude Code \(Opus|Claude Desktop|Cursor agent|Codex|GPT-?4|Cowork (did|updated|pushed|added))' || true)
        if [ -n "$matches" ]; then
            if [ "$attr_warnings" = "0" ]; then
                echo "${YELLOW}WARN: tool-attribution phrases in newly-added prose (see system/md-style.md):${NC}"
            fi
            echo "  - $mdfile"
            echo "$matches" | sed 's/^/      /'
            attr_warnings=$((attr_warnings+1))
            warnings=$((warnings+1))
        fi
    done < /tmp/_pre_attr_$$
fi
rm -f /tmp/_pre_attr_$$

# ----------------------------------------------------------------------
# Auto-bump last_updated on staged MD files — silent, re-stages on change
# Keeps freshness metadata in sync with actual edits without manual effort.
# Skips files where frontmatter is not expected (README, archive, hooks etc).
# ----------------------------------------------------------------------
today=$(date +%Y-%m-%d)
echo "$staged_files" | grep -iE '\.md$' > /tmp/_pre_bump_$$ || true
if [ -s /tmp/_pre_bump_$$ ]; then
    bumped=0
    while read -r mdfile; do
        [ -f "$mdfile" ] || continue
        case "$mdfile" in
            README.md|COWORK-PROMPT.md|archive/*|.github/*|.githooks/*) continue ;;
        esac
        first=$(head -1 "$mdfile" | tr -d '\r' | sed $'s/^\xef\xbb\xbf//')
        [ "$first" = "---" ] || continue
        if grep -qE '^last_updated:' "$mdfile"; then
            current=$(grep -m1 -E '^last_updated:' "$mdfile" | awk '{print $2}' | tr -d '\r')
            if [ "$current" != "$today" ]; then
                sed -i.bak -E "s/^last_updated:.*/last_updated: $today/" "$mdfile"
                rm -f "${mdfile}.bak"
                git add "$mdfile"
                bumped=$((bumped+1))
            fi
        fi
    done < /tmp/_pre_bump_$$
    if [ "$bumped" -gt 0 ]; then
        echo "${GREEN}auto-bumped last_updated on $bumped file(s) to $today${NC}"
    fi
fi
rm -f /tmp/_pre_bump_$$

# ----------------------------------------------------------------------
# YAML frontmatter check on changed MD files — WARN (not block)
# ----------------------------------------------------------------------
echo "$staged_files" | grep -iE '\.md$' > /tmp/_pre_md_$$ || true
if [ -s /tmp/_pre_md_$$ ]; then
    while read -r mdfile; do
        # Skip if file no longer in working tree (D files filtered out by --diff-filter=ACMR but be safe)
        [ -f "$mdfile" ] || continue
        # Skip files where frontmatter is not required.
        # Kept in lockstep with .github/workflows/frontmatter-check.yml — this
        # list was narrower than CI's until 2026-08-04, so the hook warned
        # "missing YAML frontmatter" on every single session log and changelog,
        # none of which require it. A warning that always fires is training to
        # ignore warnings.
        case "$mdfile" in
            README.md|*/README.md|COWORK-PROMPT.md|CHAT-PROMPT.md|AGENTS.md|archive/*|drafts/*|sessions/*|*/changelog/*|.github/*|.githooks/*|md-health-reports/*)
                continue ;;
        esac
        # Strip trailing CR (CRLF line endings) and a leading UTF-8 BOM
        # (\xEF\xBB\xBF) before comparing — both can be present on
        # Windows-edited files and would otherwise false-positive this check.
        first=$(head -1 "$mdfile" | tr -d '\r' | sed $'s/^\xef\xbb\xbf//')
        if [ "$first" != "---" ]; then
            if [ "$warnings" = "0" ]; then
                echo "${YELLOW}WARN: missing YAML frontmatter (see system/md-style.md):${NC}"
            fi
            echo "  - $mdfile"
            warnings=$((warnings+1))
        fi
    done < /tmp/_pre_md_$$
fi
rm -f /tmp/_pre_md_$$

# ----------------------------------------------------------------------
# Result
# ----------------------------------------------------------------------
if [ "$violations" -gt 0 ]; then
    echo ""
    echo "${RED}Pre-commit blocked: $violations violation group(s) above.${NC}"
    echo "Bypass (only if you really know): git commit --no-verify"
    exit 1
fi

if [ "$warnings" -gt 0 ]; then
    echo ""
    echo "${YELLOW}Pre-commit passed with $warnings warning(s).${NC}"
fi

echo "${GREEN}MD health checks passed.${NC}"
exit 0
